<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pure drawing core: the checks need no Godot runtime or NuGet test framework. -->
    <Compile Include="../../game/scripts/Rendering/PixelArt/PixelPalette.cs" Link="Art/PixelPalette.cs" />
    <Compile Include="../../game/scripts/Rendering/PixelArt/PixelRecipe.cs" Link="Art/PixelRecipe.cs" />
    <Compile Include="../../game/scripts/Rendering/PixelArt/PixelRecipes.*.cs" Link="Art/%(Filename)%(Extension)" />
    <Compile Include="../../game/scripts/Rendering/PixelArt/PixelRasterizer.cs" Link="Art/PixelRasterizer.cs" />
    <Compile Include="../../game/scripts/Rendering/PixelArt/PixelAtlasPacker.cs" Link="Art/PixelAtlasPacker.cs" />
    <Compile Include="../../src/BearAdventure.Domain/Gameplay/ItemType.cs" Link="ItemType.cs" />
  </ItemGroup>
</Project>
